+bool relative_jump_word(uint64_t from, uint64_t target, uint32_t& word) {
+    if ((from | target) & 3) return false;
+    int32_t words;
+    if (target >= from) {
+        const uint64_t distance = target - from;
+        if (distance > (uint64_t{1} << 27) - 4) return false;
+        words = static_cast<int32_t>(distance / 4);
+    } else {
+        const uint64_t distance = from - target;
+        if (distance > (uint64_t{1} << 27)) return false;
+        words = -static_cast<int32_t>(distance / 4);
+    }
+    word = b_uncond(words);
+    return true;
+}
