+        call.virtual_invalidate_code.addr = wine_server_client_ptr( addr );
+        call.virtual_invalidate_code.size = size;
+        status = server_queue_process_apc( process, &call, &result );
+        if (!status) status = result.virtual_invalidate_code.status;
